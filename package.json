{
  "name": "al-bayan-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-amplify-outputs.mjs && node scripts/media-manifest.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/ensure-amplify-outputs.mjs && node scripts/media-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=1 next build",
    "media:placeholders": "node scripts/make-placeholders.mjs && node scripts/media-manifest.mjs",
    "media:hero": "bash scripts/encode-hero.sh && node scripts/media-manifest.mjs",
    "media:manifest": "node scripts/media-manifest.mjs",
    "content:todo": "node scripts/content-todo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "aws-amplify": "^6.22.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^15.5.28",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
